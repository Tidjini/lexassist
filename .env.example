DEBUG=True
SECRET_KEY=change-me-in-production

# PostgreSQL — requis par django-tenants (pas de SQLite)
DATABASE_URL=postgres://user:password@localhost:5432/lexassist

# Redis — broker Celery / channel layer
REDIS_URL=redis://localhost:6379/0

# IA documentaire (classification + extraction via Claude vision)
ANTHROPIC_API_KEY=

# Sans clé API : simule l'analyse des documents (à partir du nom du fichier — voir
# apps.documents.vision.analizar_documento_simulado) et les réponses de l'assistant (par
# mots-clés — voir apps.assistant.service) pour tester toute la procédure avec des
# documents fictifs. Toujours False par défaut, jamais activé automatiquement.
IA_MODO_SIMULADO=False

# Production uniquement
# ALLOWED_HOSTS=mondomaine.es,www.mondomaine.es
# CORS_ALLOWED_ORIGINS=https://mondomaine.es
